{
  "name": "factory",
  "version": "0.1.0",
  "private": true,
  "description": "A web dashboard where a team of AI coding agents works through your GitHub issues (cubefarm's orchestrator, without the 3D office).",
  "keywords": [
    "claude-code",
    "codex",
    "opencode",
    "claude-agent-sdk",
    "ai-agents",
    "coding-agents",
    "github-issues",
    "automation",
    "dashboard"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gjugo/factory.git"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "factory": "bin/factory.js"
  },
  "files": [
    "bin",
    "dist",
    "dist-server"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/office.mjs --dev",
    "demo": "node scripts/office.mjs --dev --demo",
    "build": "tsc --noEmit -p tsconfig.json && vite build && node scripts/build-server.mjs",
    "start": "node scripts/office.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm test && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.283",
    "@hookform/resolvers": "^6.0.2",
    "@lydell/node-pty": "1.2.0-beta.15",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@playwright/mcp": "0.0.83",
    "@upstash/box": "^0.7.9",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "cmdk": "^1.1.1",
    "cn": "^0.5.1",
    "express": "^5.2.1",
    "radix-ui": "^1.8.1",
    "react-hook-form": "^7.91.0",
    "react-resizable-panels": "^4.15.3",
    "recharts": "^3.8.0",
    "ws": "^8.22.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.65.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router": "^8.5.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "zustand": "^5.0.15"
  }
}
